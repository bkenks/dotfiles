#!/usr/bin/env bash
#MISE description="Crawl a docs site sitemap into the Claude documentation skill, then have Claude catalog it"
#MISE raw=true
#USAGE arg "<name>" help="Library slug, used as the page filename (e.g. likec4)"
#USAGE arg "<sitemap>" help="Sitemap URL (e.g. https://docs.example.com/sitemap.xml)"
#USAGE flag "-f --filter <regex>" help="Only crawl URLs matching this regex" default="."
# shellcheck disable=SC2154 # usage_* variables are injected by mise from the USAGE spec
set -euo pipefail

skill_dir="${HOME}/.claude/skills/documentation"
page_file="${skill_dir}/pages/${usage_name}.md"
reader_url="https://r.jina.ai"
request_delay_seconds=3
keyed_parallel_count=8

if [[ ! "${usage_name}" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "ERRO | name must be a lowercase slug | name=${usage_name}" >&2
  exit 1
fi

if [[ ! -f "${skill_dir}/SKILL.md" ]]; then
  echo "ERRO | documentation skill not found | dir=${skill_dir}" >&2
  exit 1
fi

get_sitemap_urls() {
  local sitemap_url="$1" body locs
  if ! body="$(curl -fsSL --retry 3 "${sitemap_url}")"; then
    echo "ERRO | cannot fetch sitemap | url=${sitemap_url}" >&2
    return 1
  fi
  locs="$(rg -o '<loc>\s*([^<\s]+)\s*</loc>' -r '$1' <<<"${body}" | sed 's/&amp;/\&/g' || true)"
  if rg -q '<sitemapindex' <<<"${body}"; then
    while IFS= read -r child; do
      [[ -n "${child}" ]] && get_sitemap_urls "${child}"
    done <<<"${locs}"
  else
    printf '%s\n' "${locs}"
  fi
}

select_reference_urls() {
  local sitemap_urls="$1" picked
  picked="$(claude -p --tools "" "Below is the sitemap URL list for the ${usage_name} \
documentation. It will be crawled into a local reference that an AI coding agent searches \
when writing code with ${usage_name}. Keep pages that document the language, APIs, CLI, \
configuration, concepts, how-to guides and tutorials. Drop blog posts, news, release notes, \
changelogs, marketing, community and contact pages, tag or category listings, translations \
and duplicate versions. Reply with only the kept URLs, one per line, exactly as given." \
    <<<"${sitemap_urls}")"
  rg -xF -f <(printf '%s\n' "${sitemap_urls}") <<<"${picked}" | sort -u || true
}

sitemap_urls="$(get_sitemap_urls "${usage_sitemap}" | rg -- "${usage_filter}" | sort -u || true)"
sitemap_url_count="$(rg -c . <<<"${sitemap_urls}" || echo 0)"

if [[ "${sitemap_url_count}" -eq 0 ]]; then
  echo "ERRO | no URLs found | sitemap=${usage_sitemap} filter=${usage_filter}" >&2
  exit 1
fi

echo "INFO | asking Claude to pick reference pages | candidates=${sitemap_url_count}"
urls="$(select_reference_urls "${sitemap_urls}")"
url_count="$(rg -c . <<<"${urls}" || echo 0)"

if [[ "${url_count}" -eq 0 ]]; then
  echo "ERRO | Claude kept no sitemap URLs | candidates=${sitemap_url_count}" >&2
  exit 1
fi

echo "INFO | Claude picked pages | kept=${url_count} dropped=$((sitemap_url_count - url_count))"
printf '%s\n' "${urls}"

work_dir="$(mktemp -d)"
staged_file="${page_file}.partial"
auth_header_file="${work_dir}/auth-header"
remove_work_files() {
  rm -f "${work_dir}"/*.md "${auth_header_file}" "${staged_file}"
  rmdir "${work_dir}"
}
trap remove_work_files EXIT

if [[ -n "${JINA_API_KEY:-}" ]]; then
  parallel_count="${keyed_parallel_count}"
  request_delay_seconds=0
  (umask 077 && printf 'Authorization: Bearer %s\n' "${JINA_API_KEY}" >"${auth_header_file}")
else
  parallel_count=1
  echo "WARN | JINA_API_KEY not set, crawling serially at 20 requests/minute" >&2
fi

fetch_page() {
  local page_number="$1" url="$2" page auth_args=()
  [[ -f "${auth_header_file}" ]] && auth_args=(-H "@${auth_header_file}")
  printf 'INFO | %d/%d | %s\n' "${page_number}" "${url_count}" "${url}"
  if page="$(curl -fsS --retry 3 --retry-all-errors --retry-delay 10 \
    "${auth_args[@]}" "${reader_url}/${url}")"; then
    printf '\n\nSource: %s\n\n%s\n' "${url}" "${page}" >"${work_dir}/$(printf '%05d' "${page_number}").md"
  else
    echo "WARN | page fetch failed, skipping | url=${url}" >&2
  fi
  sleep "${request_delay_seconds}"
}
export -f fetch_page
export work_dir url_count reader_url auth_header_file request_delay_seconds

echo "INFO | crawling | urls=${url_count} parallel=${parallel_count} out=${page_file}"

awk '{ print NR; print }' <<<"${urls}" |
  tr '\n' '\0' |
  # shellcheck disable=SC2016 # positional args expand inside the child bash, not here
  xargs -0 -n 2 -P "${parallel_count}" bash -c 'fetch_page "$1" "$2"' _

shopt -s nullglob
fetched_files=("${work_dir}"/*.md)
failed_count=$((url_count - ${#fetched_files[@]}))

if [[ "${#fetched_files[@]}" -eq 0 ]]; then
  echo "ERRO | every page fetch failed, keeping existing page file" >&2
  exit 1
fi

cat "${fetched_files[@]}" >"${staged_file}"
mv "${staged_file}" "${page_file}"
remove_work_files
trap - EXIT

line_count="$(wc -l <"${page_file}" | tr -d ' ')"
echo "INFO | wrote page file | out=${page_file} lines=${line_count} failed=${failed_count}"

exec claude "A new docs crawl was written to ${page_file} (${line_count} lines, \
${url_count} pages from ${usage_sitemap}). Each page starts with a 'Source: <url>' line, \
the same layout as pages/openhands.md. Update ${skill_dir}/SKILL.md following its \
'To add a library' instructions: add or refresh the catalog row (search the file with \
rg to write an accurate Covers summary, never read it whole), add the library to the \
description frontmatter, and note in Retrieval that its TOC is the Source: lines if \
that is not already covered."
