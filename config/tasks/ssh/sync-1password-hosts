#!/usr/bin/env bash
#MISE description="Mirror 1Password SSH Match hosts into plain Host blocks"
set -euo pipefail

source_config="${HOME}/.ssh/1Password/config"
target_config="${HOME}/.ssh/1password-hosts"

if [[ ! -r "${source_config}" ]]; then
  echo "error: cannot read ${source_config}; enable SSH bookmarks in 1Password" >&2
  exit 1
fi

hosts="$(
  awk 'tolower($1) == "match" && tolower($2) == "host" { print $3 }' "${source_config}" |
    tr ',' '\n' |
    grep -v '[*?!]' |
    sort -u
)"

staged_config="$(mktemp "${target_config}.XXXXXX")"
trap 'rm -f "${staged_config}"' EXIT

{
  echo "# Generated by mise task ssh:sync-1password-hosts. Do not edit."
  while IFS= read -r host; do
    [[ -n "${host}" ]] && printf '\nHost %s\n' "${host}"
  done <<<"${hosts}"
} >"${staged_config}"

chmod 600 "${staged_config}"
mv "${staged_config}" "${target_config}"
trap - EXIT

echo "Synced $(grep -c '^Host ' "${target_config}") hosts to ${target_config}"
